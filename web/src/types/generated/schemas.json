    "WindowJudgement": {
      "$defs": {
        "Category": {
          "description": "Annotation/alert taxonomy. Must match docs/02_DATA_PLAN.md §3.4.",
          "enum": [
            "slang_profanity",
            "insult",
            "threat",
            "sexual_harassment",
            "hate_identity",
            "disrespect_register",
            "harsh_tone",
            "shouting",
            "sarcasm_mockery",
            "dismissive_rude",
            "interruption_overtalk"
          ],
          "title": "Category",
          "type": "string"
        },
        "ContextFlag": {
          "description": "Shared by annotation, text models, LLM judge and fusion (D-04).",
          "enum": [
            "banter",
            "reported_speech",
            "self_directed",
            "partial",
            "quoted_policy",
            "neutral_register",
            "unsure"
          ],
          "title": "ContextFlag",
          "type": "string"
        },
        "JudgedEvent": {
          "additionalProperties": false,
          "properties": {
            "category": {
              "$ref": "#/$defs/Category"
            },
            "confidence": {
              "maximum": 1,
              "minimum": 0,
              "title": "Confidence",
              "type": "number"
            },
            "context_flags": {
              "items": {
                "$ref": "#/$defs/ContextFlag"
              },
              "title": "Context Flags",
              "type": "array"
            },
            "evidence": {
              "description": "verbatim substring of the input utterance(s)",
              "title": "Evidence",
              "type": "string"
            },
            "rationale_bn": {
              "maxLength": 200,
              "title": "Rationale Bn",
              "type": "string"
            },
            "rationale_en": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Rationale En"
            },
            "severity": {
              "enum": [
                1,
                2,
                3
              ],
              "title": "Severity",
              "type": "integer"
            },
            "speaker": {
              "$ref": "#/$defs/Speaker"
            },
            "target": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Target"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "utterance_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Utterance Id"
            }
          },
          "required": [
            "speaker",
            "category",
            "severity",
            "confidence",
            "evidence",
            "rationale_bn"
          ],
          "title": "JudgedEvent",
          "type": "object"
        },
        "ProvisionalDecision": {
          "additionalProperties": false,
          "properties": {
            "decision": {
              "enum": [
                "confirm",
                "dismiss",
                "change_category",
                "change_severity"
              ],
              "title": "Decision",
              "type": "string"
            },
            "event_id": {
              "title": "Event Id",
              "type": "string"
            },
            "new_category": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Category"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "new_severity": {
              "anyOf": [
                {
                  "enum": [
                    1,
                    2,
                    3
                  ],
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "New Severity"
            },
            "reason_bn": {
              "anyOf": [
                {
                  "maxLength": 160,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Reason Bn"
            }
          },
          "required": [
            "event_id",
            "decision"
          ],
          "title": "ProvisionalDecision",
          "type": "object"
        },
        "Speaker": {
          "enum": [
            "agent",
            "customer"
          ],
          "title": "Speaker",
          "type": "string"
        },
        "Target": {
          "description": "Who a behaviour is aimed at (D-03).",
          "enum": [
            "agent",
            "customer",
            "company",
            "third_party",
            "self",
            "none"
          ],
          "title": "Target",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "properties": {
        "events": {
          "items": {
            "$ref": "#/$defs/JudgedEvent"
          },
          "title": "Events",
          "type": "array"
        },
        "provisional_decisions": {
          "items": {
            "$ref": "#/$defs/ProvisionalDecision"
          },
          "title": "Provisional Decisions",
          "type": "array"
        }
      },
      "required": [
        "events",
        "provisional_decisions"
      ],
      "title": "WindowJudgement",
      "type": "object"
    },
    "Word": {
      "additionalProperties": false,
      "description": "One recognised word. ``word`` is already redacted (PII words replaced by tags).",
      "properties": {
        "conf": {
          "maximum": 1,
          "minimum": 0,
          "title": "Conf",
          "type": "number"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "number"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "number"
        },
        "word": {
          "title": "Word",
          "type": "string"
        }
      },
      "required": [
        "word",
        "start",
        "end",
        "conf"
      ],
      "title": "Word",
      "type": "object"
    }
  },
  "schema_version": "1"
}
