# Keep build contexts small and free of data, caches and secrets (docs/05 §7).
.git
.gale
.venv
**/__pycache__
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
web/node_modules
web/.next
web/test-results
web/playwright-report
data
*.wav
!tests/fixtures/**/*.wav
docs/screenshots
**/.env
**/*.key
**/*.pem
